# Salin ke deploy/.env lalu isi. File .env jangan di-commit.

# Domain (atau IP.sslip.io) yang sudah diarahkan ke IP VPS lewat DNS A record.
API_DOMAIN=api.example.com

# Domain frontend yang boleh memanggil API, pisahkan dengan koma.
# Contoh: https://chessrecs.example.com,https://www.chessrecs.example.com
# Isi "*" hanya saat uji coba.
CORS_ORIGINS=*
